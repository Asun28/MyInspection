{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prereview state v1",
  "$comment": "State-owned fields only. Test-PrereviewState additionally validates units and reconstructed candidate/coverage content through the frozen RECORDS validator; no record $defs are copied here.",
  "type": "object", "additionalProperties": false,
  "required": ["state_version", "task_id", "snapshot_tree", "head_sha", "base_oid", "base_mode", "merge_base", "policy_hash", "rubric_sha", "workers", "units", "candidates", "coverage", "disputes", "stop_reason"],
  "properties": {
    "state_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^T[0-9]+-[A-Z0-9]+(-[A-Z0-9]+)*(?![\\s\\S])" },
    "snapshot_tree": { "$ref": "#/$defs/oid" }, "head_sha": { "$ref": "#/$defs/oid" },
    "base_oid": { "$ref": "#/$defs/oid" }, "merge_base": { "$ref": "#/$defs/oid" },
    "base_mode": { "enum": ["local", "remote"] },
    "policy_hash": { "$ref": "#/$defs/digest" }, "rubric_sha": { "$ref": "#/$defs/digest" },
    "workers": { "type": "array", "items": { "$ref": "#/$defs/worker" } },
    "units": { "type": "array", "items": { "type": "object" } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/minted" } },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/state_coverage" } },
    "disputes": { "type": "array", "items": { "$ref": "#/$defs/dispute" } },
    "stop_reason": { "type": ["string", "null"] }
  },
  "$defs": {
    "oid": { "type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
    "cid": { "type": "string", "pattern": "^C-[1-9][0-9]*(?![\\s\\S])" },
    "text": { "type": "string", "minLength": 1 },
    "worker": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "model", "effort", "lens", "required", "status", "skip_code", "duration_s", "exit_code", "usage"],
      "properties": {
        "id": { "$ref": "#/$defs/text" }, "model": { "$ref": "#/$defs/text" }, "effort": { "$ref": "#/$defs/text" },
        "lens": { "type": "boolean" }, "required": { "type": "boolean" },
        "status": { "enum": ["complete", "incomplete", "skipped"] }, "skip_code": { "type": ["string", "null"] },
        "duration_s": { "type": "number", "minimum": 0 }, "exit_code": { "type": ["integer", "null"] }, "usage": { "type": ["object", "null"] }
      }
    },
    "minted": {
      "type": "object", "required": ["id", "fingerprint", "root_group", "related_to", "provenance"],
      "properties": {
        "id": { "$ref": "#/$defs/cid" }, "fingerprint": { "$ref": "#/$defs/text" }, "root_group": { "$ref": "#/$defs/cid" },
        "related_to": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/cid" } },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contributor" } }
      }
    },
    "contributor": {
      "type": "object", "additionalProperties": false,
      "required": ["worker_id", "local_id", "snapshot_tree", "model_id", "lens", "schema_version", "schema_revision", "kind", "severity_guess", "anchor", "line_start", "line_end"],
      "properties": {
        "worker_id": { "$ref": "#/$defs/text" }, "local_id": { "$ref": "#/$defs/text" },
        "snapshot_tree": { "$ref": "#/$defs/oid" }, "model_id": { "$ref": "#/$defs/text" }, "lens": { "type": "boolean" },
        "schema_version": { "type": "integer" }, "schema_revision": { "type": "integer" },
        "kind": {}, "severity_guess": {}, "anchor": {}, "line_start": {}, "line_end": {}
      }
    },
    "state_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["unit_id", "worker_id", "categories_checked", "status", "candidate_ids", "missing_context"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/text" }, "worker_id": { "type": ["string", "null"] },
        "categories_checked": { "type": "array" }, "status": { "enum": ["checked_no_finding", "finding", "not_applicable", "blocked", "missing"] },
        "candidate_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/cid" } }, "missing_context": { "type": "array" }
      },
      "if": { "properties": { "status": { "const": "missing" } } },
      "then": { "properties": { "worker_id": { "type": "null" }, "categories_checked": { "maxItems": 0 }, "candidate_ids": { "maxItems": 0 }, "missing_context": { "maxItems": 0 } } },
      "else": { "properties": { "worker_id": { "$ref": "#/$defs/text" } } }
    },
    "dispute": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "r3_round", "r3_sha", "reason_index", "reason_sha256", "relation", "by", "at"],
      "if": { "properties": { "relation": { "const": "new" } } },
      "then": { "properties": { "candidate_id": { "type": "null" } } },
      "else": { "properties": { "candidate_id": { "$ref": "#/$defs/cid" } } },
      "properties": {
        "candidate_id": { "anyOf": [{ "$ref": "#/$defs/cid" }, { "type": "null" }] },
        "r3_round": { "type": "integer", "minimum": 1 }, "r3_sha": { "$ref": "#/$defs/oid" },
        "reason_index": { "type": "integer", "minimum": 0 }, "reason_sha256": { "$ref": "#/$defs/digest" },
        "relation": { "enum": ["same", "related", "new"] }, "by": { "$ref": "#/$defs/text" }, "at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
