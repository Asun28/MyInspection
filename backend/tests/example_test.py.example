# backend/tests/example_test.py — 确定性离线单测示例（拷掉 .example 即用）。
# 闸 4 示范：纯本地、零网络、可当任务卡 dod_command 跑、退出码即闸。
from fastapi.testclient import TestClient

from app.main import HealthOut, app

client = TestClient(app)


def test_health_contract_fields():
    # 断言对外字段名 == 契约字段名（snake_case）——前端类型由同一 OpenAPI 生成，物理上不漂移。
    resp = client.get("/health")
    assert resp.status_code == 200
    body = resp.json()
    assert set(body) == {"status", "uptime_seconds"}


def test_health_out_model_validates():
    # pydantic 契约自校验：负 uptime 应被拒（ge=0）。
    import pytest
    from pydantic import ValidationError

    HealthOut(status="ok", uptime_seconds=0)  # ok
    with pytest.raises(ValidationError):
        HealthOut(status="ok", uptime_seconds=-1)
