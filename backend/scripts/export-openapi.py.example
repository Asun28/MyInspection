# backend/scripts/export-openapi.py — 导出 OpenAPI 契约（拷掉 .example 即用）。
# 用法：python scripts/export-openapi.py > openapi.json
# 角色：闭合「前端闸 2」契约环——前端 openapi-typescript 吃这份 openapi.json 生成 src/types/api.ts，
#       前端只 import 生成的类型，userId vs user_id 这类漂移由此根除（见 frontend/README.md 闸 2）。
# 确定性：纯本地、零网络；CI 可把它接进 verify 链，断言契约未漂移（diff openapi.json）。
import json
import sys

from app.main import app  # FastAPI 实例（按你的包路径调整）


def main() -> None:
    schema = app.openapi()
    json.dump(schema, sys.stdout, indent=2, sort_keys=True, ensure_ascii=False)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
