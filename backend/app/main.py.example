# backend/app/main.py — 最小 FastAPI 契约示例（拷掉 .example 即用）。
# 角色：它发出的 OpenAPI 是「接口单一真相源」——前端闸 2 由此生成类型，字段名物理上无法漂移。
# 红线：这是**骨架示例**，非业务实现；下游按真实领域替换 schema 与路由（元层不装业务码）。
from fastapi import FastAPI
from pydantic import BaseModel, Field

app = FastAPI(title="Example API", version="0.1.0")


class HealthOut(BaseModel):
    """对外契约：字段一律 snake_case；改字段=改契约=走版本评审。"""

    status: str = Field(description="liveness flag, e.g. 'ok'")
    uptime_seconds: int = Field(ge=0, description="process uptime in whole seconds")


@app.get("/health", response_model=HealthOut)
def health() -> HealthOut:
    # 业务逻辑留应用层（闸 5）；此处仅示例。真实实现从注入的 clock/服务取值。
    return HealthOut(status="ok", uptime_seconds=0)
