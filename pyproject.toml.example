# 重命名为 pyproject.toml 使用（init-scaffold.ps1 会自动重命名 + 填充）。
# 仅当你项目有 Python 后端时需要；非 Python 项目可删除本文件。
[project]
name = "myinspection-backend"
version = "0.1.0"
description = "MyInspection"
requires-python = ">=3.13"
dependencies = [
    # 例：
    # "fastapi",
    # "uvicorn[standard]",
    # "pydantic>=2",
]

[dependency-groups]
# jsonschema（MIT）：dev-only——若用 specs/verdict.schema.json 校验 review 机读裁决可保留。
# ruff（MIT）：dev-only——verify.ps1 闸 1 的常设 lint 兜底（见下方 [tool.ruff.lint]）。
dev = ["pytest", "jsonschema", "ruff"]

# 后端用系统已装的 Python（真实模型的独立子环境在后续阶段单独建，互不干扰）：
#   uv venv --python 3.13 .venv
#   uv sync
[tool.uv]
package = false

# Ruff：机检 Python 命名约定（见 CLAUDE.md「代码与接口命名」），让命名错误确定性拦截而非靠人评审。
# extend-select 在 ruff 默认（E/F）之上加 N=pep8-naming（snake_case 函数/变量、PascalCase 类、UPPER_SNAKE 常量）。
# 把 `ruff check .` 放进对应任务卡的 dod_command；verify.ps1 闸 1 亦兜底（pyproject + uv 就绪时自动跑）——命名漂移即在 ship 前红灯。
[tool.ruff.lint]
extend-select = ["N"]
