{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prereview record schema v1 (worker_output envelope + candidate / coverage / facts / units $defs)",
  "$comment": "Frozen contract of PR review v2; contract text and projection rule in specs/tasks/T0-PREREVIEW-SCHEMA.md, machine check scripts/check-prereview-schema.ps1. In-window patches bump schema_revision.",
  "description": "worker_output: what one prereview worker returns.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "schema_revision", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "schema_revision": { "const": 0, "description": "Current revision; any in-window patch bumps it here and in every fixture, so stale fixtures fail explicitly." },
    "records": {
      "type": "array",
      "description": "Candidate and coverage records only; one coverage record per changed unit.",
      "items": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "$ref": "#/$defs/coverage" }] }
    }
  },
  "$defs": {
    "category": { "type": "string", "enum": ["C1", "C2", "C3", "C4", "C5", "C7"], "description": "C1 written guarantee exceeds evidence, C2 real production defect, C3 weak evidence, C4 base or process drift, C5 scope or placement, C7 other." },
    "unit_id": { "type": "string", "pattern": "^.+#([0-9a-f]{12}|file)$", "description": "A unit_id from units.json: path, hash sign, first 12 hex of the sha256 of the normalised hunk body, or path#file for binary or over-size files." },
    "git_oid": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_id", "kind", "severity_guess", "category", "anchor", "file", "symbol", "line_start", "line_end", "unit_ids", "trigger", "expected", "actual", "impact", "contract_ref", "evidence_refs", "evidence_needed", "introduced_or_worsened", "suggested_fix_direction"],
      "properties": {
        "local_id": { "type": "string", "minLength": 1, "description": "Worker-local identifier, unique within this envelope; RECORDS mints the C-n id." },
        "kind": { "type": "string", "enum": ["defect", "question", "suggestion"] },
        "severity_guess": { "enum": ["critical", "high", "medium", "low", null] },
        "category": { "$ref": "#/$defs/category" },
        "anchor": { "type": "string", "enum": ["hunk", "file", "absent"], "description": "hunk = inside a changed hunk, file = elsewhere in a changed file, absent = anywhere else in the snapshot tree." },
        "file": { "type": "string", "minLength": 1, "description": "A path of the snapshot tree (forward slashes, repository-relative)." },
        "symbol": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }], "description": "Function, class or heading; null only when line_start is an integer." },
        "line_start": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "line_end": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "unit_ids": { "type": "array", "items": { "$ref": "#/$defs/unit_id" }, "description": "May be empty; membership in units.json is checked by RECORDS." },
        "trigger": { "type": "string", "minLength": 1, "description": "What in the diff or tree raised the finding." },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "contract_ref": { "type": "string", "pattern": "^(lesson:L[0-9]+|rubric:[0-9]+|acceptance:[AR][0-9]+|frozen:.+|none)$", "description": "lesson:L{n} | rubric:{n} | acceptance:A{n} or R{n} | frozen:{path} | none" },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Locations already read that support the finding (path:line or unit_id)." },
        "evidence_needed": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "What would settle the finding but was not available in the pack." },
        "introduced_or_worsened": { "type": "string", "enum": ["introduced", "worsened", "pre_existing"] },
        "suggested_fix_direction": { "type": "string" }
      },
      "if": { "properties": { "symbol": { "type": "null" } } },
      "then": { "properties": { "line_start": { "type": "integer" } } }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "categories_checked", "status", "candidate_local_ids", "missing_context"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/unit_id" },
        "categories_checked": { "type": "array", "items": { "$ref": "#/$defs/category" }, "uniqueItems": true },
        "status": { "type": "string", "enum": ["checked_no_finding", "finding", "not_applicable", "blocked"], "description": "missing is state-only (synthesised by RECORDS) and is not a worker value." },
        "candidate_local_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "local_id values of the candidates raised on this unit." },
        "missing_context": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Non-empty when status is blocked: the locations the worker needed and could not read." }
      },
      "if": { "properties": { "status": { "const": "blocked" } } },
      "then": { "properties": { "missing_context": { "minItems": 1 } } }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_tree", "head_sha", "base_oid", "base_mode", "merge_base", "policy_hash", "rubric_sha", "models", "risk_class", "pack_layout_version"],
      "properties": {
        "snapshot_tree": { "$ref": "#/$defs/git_oid" },
        "head_sha": { "$ref": "#/$defs/git_oid" },
        "base_oid": { "$ref": "#/$defs/git_oid" },
        "base_mode": { "type": "string", "enum": ["local", "remote"], "description": "local = refs/heads/{base} (-Local), remote = refs/remotes/origin/{base}." },
        "merge_base": { "$ref": "#/$defs/git_oid" },
        "policy_hash": { "$ref": "#/$defs/sha256_hex", "description": "SHA-256 over docs/PREREVIEW-CHECKLISTS.md plus this file at the merge-base commit." },
        "rubric_sha": { "$ref": "#/$defs/sha256_hex", "description": "Informational: docs/QUALITY-RUBRIC.md at the merge-base." },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discoverer", "lens"],
          "properties": {
            "discoverer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["model", "effort"],
              "properties": { "model": { "type": "string", "minLength": 1 }, "effort": { "type": "string", "minLength": 1 } }
            },
            "lens": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "model", "doc_model", "effort"],
              "properties": { "enabled": { "type": "boolean" }, "model": { "type": "string", "minLength": 1 }, "doc_model": { "type": "string", "minLength": 1 }, "effort": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "risk_class": { "type": "string", "enum": ["standard", "risky"], "description": "risky = a changed path hits FrozenPaths or PrereviewRiskyExtraPaths." },
        "pack_layout_version": { "type": "integer", "minimum": 1 }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "file", "hunk_header", "body_sha256"],
      "properties": {
        "unit_id": { "$ref": "#/$defs/unit_id" },
        "file": { "type": "string", "minLength": 1 },
        "hunk_header": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }], "description": "The @@ header of the hunk; null for a path#file unit." },
        "body_sha256": { "$ref": "#/$defs/sha256_hex", "description": "SHA-256 of the normalised hunk body (whole file for a path#file unit); unit_id carries its first 12 hex." }
      }
    },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" }, "description": "units.json: one entry per changed unit." },
    "status_code": {
      "type": "string",
      "description": "The 20 ASCII status codes; the protocol doc table is anchor-tested against this enum.",
      "enum": [
        "[PRE-NO-MERGE-BASE]", "[PRE-SECRETS]", "[PRE-NO-NETWORK-IN-CI]", "[PRE-LIVE-REFUSED]", "[PRE-WORKER-MISSING]",
        "[PRE-NO-OUTPUT]", "[PRE-TIMEOUT]", "[PRE-BAD-RECORD]", "[PRE-LENS-SKIPPED]", "[PRE-PACKET-READY]",
        "[PRE-RUN-DISABLED]", "[PRE-BUDGET-AFTER-FIX]", "[PRE-BATCH-CAP]", "[PRE-MISSING]", "[PRE-STALE]",
        "[PRE-OPEN]", "[PRE-INCOMPLETE]", "[PRE-SKIPPED]", "[PRE-DISABLED]", "[PRE-GATE-PASS]"
      ]
    }
  }
}
