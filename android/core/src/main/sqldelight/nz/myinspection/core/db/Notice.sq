CREATE TABLE notice (
    id TEXT NOT NULL PRIMARY KEY,
    inspection_id TEXT NOT NULL, -- 逻辑外键 -> inspection.id
    full_text TEXT NOT NULL, -- 全文快照
    generated_at INTEGER NOT NULL, -- 一行 notice 恒在生成的那一刻插入，兼作行创建时间，不另设 created_at
    sent_via TEXT, -- 可空：生成后尚未发送；app 自己不发送，人工发送后回记
    sent_at INTEGER,
    lead_hours INTEGER NOT NULL, -- 提前量小时数；≥48 且 ≤14 天的上下限校验归 T4-COMPLIANCE-ENGINE
    validation_snapshot TEXT NOT NULL, -- 生成时的合规校验结果快照（JSON）
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX idx_notice_inspection ON notice (inspection_id);

insert:
INSERT INTO notice (id, inspection_id, full_text, generated_at, sent_via, sent_at, lead_hours, validation_snapshot, updated_at)
VALUES (:id, :inspection_id, :full_text, :generated_at, :sent_via, :sent_at, :lead_hours, :validation_snapshot, :updated_at);

selectById:
SELECT *
FROM notice
WHERE id = :id;

selectByInspection:
SELECT *
FROM notice
WHERE inspection_id = :inspection_id AND deleted_at IS NULL;

-- 回记送达（T4-NOTICES 流程最后一步：生成→复制→用户自行发送→回 app 记送达方式+时刻；其 allow_paths
-- 不含 core/db/）。lead_hours 重算与 validation_snapshot 更新的逻辑归 T4-NOTICES，本卡只给机械写路径。
-- `AND sent_at IS NULL` 令这一步一次性——T4-NOTICES dod_assert 原文"回记送达后提前量重算并锁定"，
-- 锁定语义落在这条 WHERE 上：已回记过的 notice 再调用一次是 0 行受影响，不会覆盖第一次的送达记录。
recordDelivery:
UPDATE notice
SET sent_via = :sent_via, sent_at = :sent_at, lead_hours = :lead_hours, validation_snapshot = :validation_snapshot, updated_at = :updated_at
WHERE id = :id AND sent_at IS NULL;
