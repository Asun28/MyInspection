CREATE TABLE audio (
    id TEXT NOT NULL PRIMARY KEY,
    inspection_item_id TEXT NOT NULL, -- 逻辑外键 -> inspection_item.id
    rel_path TEXT NOT NULL, -- 相对路径；文件系统存储，DB 禁 BLOB
    content_hash TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

-- 原始音频永远保留（关键不变量：识别会失败，换模型后可重跑历史音频）：本卡故意不提供 delete 查询。

CREATE INDEX idx_audio_inspection_item ON audio (inspection_item_id);

-- finalize 只读强制（关键不变量）：巡检 FINALIZED 后不得再挂新音频，否则 data_hash 锁定的快照会被
-- 事后追加内容破坏（原始音频本身"永远保留"是不同的不变量——那条管的是不删旧的，这条管的是不加新的）。
-- 音频没有直接的 inspection_id 列，经 inspection_item 两跳查父巡检的 finalized_at。
insert:
INSERT INTO audio (id, inspection_item_id, rel_path, content_hash, updated_at)
SELECT :id, :inspection_item_id, :rel_path, :content_hash, :updated_at
WHERE (
  SELECT finalized_at FROM inspection WHERE id = (
    SELECT inspection_id FROM inspection_item WHERE id = :inspection_item_id
  )
) IS NULL;

selectById:
SELECT *
FROM audio
WHERE id = :id;

selectByInspectionItem:
SELECT *
FROM audio
WHERE inspection_item_id = :inspection_item_id AND deleted_at IS NULL;
