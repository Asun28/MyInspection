-- property_id / baseline_inspection_id 均为逻辑外键（项目默认，见 .claude/skills/database-design；非物理
-- REFERENCES：既避免 SQLite 建表顺序对物理 FK 的隐性依赖，也匹配软删除父行仍需被子行合法引用的语义）。
CREATE TABLE tenancy (
    id TEXT NOT NULL PRIMARY KEY,
    property_id TEXT NOT NULL, -- 逻辑外键 -> property.id
    start_ms INTEGER NOT NULL,
    end_ms INTEGER,
    tenant_name TEXT, -- 可空：保留期（租约结束 12 个月）到期后置 NULL（T5-RETENTION），绝不删行
    contact TEXT,
    baseline_inspection_id TEXT, -- 逻辑外键 -> inspection.id；该 tenancy 的权威基线指针（可后指定，见用户已签认决策）
    purged_at INTEGER, -- 可空：保留期清理（T5-RETENTION）执行时间戳；NULL=尚未清理
    created_at INTEGER NOT NULL, -- 行创建时间（见 Property.sq 同名列注释）
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX idx_tenancy_property ON tenancy (property_id);
CREATE INDEX idx_tenancy_baseline_inspection ON tenancy (baseline_inspection_id);

-- purged_at 不在插入列里，与 deleted_at 同理——新建的租约恒未清理，交给 SQLite 的空列默认值（NULL）。
insert:
INSERT INTO tenancy (id, property_id, start_ms, end_ms, tenant_name, contact, baseline_inspection_id, created_at, updated_at)
VALUES (:id, :property_id, :start_ms, :end_ms, :tenant_name, :contact, :baseline_inspection_id, :created_at, :updated_at);

selectById:
SELECT *
FROM tenancy
WHERE id = :id;

selectActive:
SELECT *
FROM tenancy
WHERE deleted_at IS NULL;

-- 既有租约没有 Ingoing 时，把某次 Routine 巡检指定为该 tenancy 的基线（用户已签认决策，见卡片正文）。
-- Exit 的对照方一律读这一列，不得假设「必有 type=INGOING 的巡检」。
updateBaselineInspection:
UPDATE tenancy
SET baseline_inspection_id = :baseline_inspection_id, updated_at = :updated_at
WHERE id = :id;

-- 保留期清理的机械执行面（T5-RETENTION 的 allow_paths 不含 core/db/，只能调用本卡已生成的 API）：
-- 置空联系方式 + 标记 purged_at，绝不 DELETE 行——巡检/照片/报告哈希链仍是法定证据。何时/是否清理归
-- T5-RETENTION。`AND :purged_at IS NOT NULL` 是**运行期** WHERE 守卫，不是编译期类型保证——曾以为
-- 复用 `:updated_at` 能让这条路径"类型层面不可能传 NULL"，SQLDelight 2.3.2 按参数名在整条语句里出现
-- 的所有位置推断可空性，绑到可空列（purged_at）的那一次用法会把生成的 Kotlin 参数类型拉回 `Long?`，
-- 假设是错的（实测核验，已改正）。传 NULL 时整条 UPDATE 是 0 行、不落地——不会出现"联系方式已清空但
-- purged_at 仍是 NULL"的自相矛盾态。
purgeContactInfo:
UPDATE tenancy
SET tenant_name = NULL, contact = NULL, purged_at = :purged_at, updated_at = :updated_at
WHERE id = :id AND :purged_at IS NOT NULL;
