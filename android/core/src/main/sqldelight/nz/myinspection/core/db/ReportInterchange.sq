-- One provenance receipt per inspection; inspection_id reuses the native UUID identity.
-- Immutable evidence has imported_at rather than mutable audit/soft-delete fields,
-- as with archive receipts. COMMIT owns live inspection authorization and lifecycle.
-- JSON is the PLANNER's canonical, privacy-reviewed receipt: SQL does not validate
-- its grammar, hash agreement or content. Date checks here enforce storage shape;
-- the planner/commit boundary owns strict calendar validity.
CREATE TABLE report_import_receipt (
    inspection_id TEXT NOT NULL PRIMARY KEY,
    source_sha256 TEXT NOT NULL,
    source_byte_size INTEGER NOT NULL,
    extractor_version TEXT NOT NULL,
    manifest_sha256 TEXT NOT NULL,
    source_date TEXT NOT NULL,
    mapping_receipt_json TEXT NOT NULL,
    mapping_sha256 TEXT NOT NULL,
    imported_at INTEGER NOT NULL,
    CHECK (typeof(inspection_id) = 'text' AND length(inspection_id) > 0),
    CHECK (typeof(source_sha256) = 'text' AND length(source_sha256) = 64 AND length(CAST(source_sha256 AS BLOB)) = 64 AND source_sha256 NOT GLOB '*[^0-9a-f]*'),
    CHECK (typeof(source_byte_size) = 'integer' AND source_byte_size > 0),
    CHECK (typeof(extractor_version) = 'text' AND length(extractor_version) BETWEEN 1 AND 64
        AND length(CAST(extractor_version AS BLOB)) = length(extractor_version) AND extractor_version NOT GLOB '*[^A-Z0-9_-]*'),
    CHECK (typeof(manifest_sha256) = 'text' AND length(manifest_sha256) = 64 AND length(CAST(manifest_sha256 AS BLOB)) = 64 AND manifest_sha256 NOT GLOB '*[^0-9a-f]*'),
    CHECK (typeof(source_date) = 'text' AND length(CAST(source_date AS BLOB)) = 10
        AND source_date GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'),
    CHECK (typeof(mapping_receipt_json) = 'text' AND length(mapping_receipt_json) > 0),
    CHECK (typeof(mapping_sha256) = 'text' AND length(mapping_sha256) = 64 AND length(CAST(mapping_sha256 AS BLOB)) = 64 AND mapping_sha256 NOT GLOB '*[^0-9a-f]*'),
    CHECK (typeof(imported_at) = 'integer' AND imported_at > 0)
);

-- Source lookup/idempotency index. The INSERT guard below enforces uniqueness
-- even for caller-supplied OR IGNORE / OR REPLACE, independent of recursive_triggers.
CREATE INDEX idx_report_import_receipt_source ON report_import_receipt (source_sha256);

-- v6 evidence-only guards: abort without side effects; no domain writes in triggers.
CREATE TRIGGER report_import_receipt_no_duplicate
BEFORE INSERT ON report_import_receipt
WHEN new.inspection_id IN (SELECT inspection_id FROM report_import_receipt)
    OR new.source_sha256 IN (SELECT source_sha256 FROM report_import_receipt)
BEGIN
    SELECT RAISE(ABORT, 'Duplicate import provenance');
END;

CREATE TRIGGER report_import_receipt_no_update
BEFORE UPDATE ON report_import_receipt
BEGIN
    SELECT RAISE(ABORT, 'Immutable import provenance');
END;

CREATE TRIGGER report_import_receipt_no_delete
BEFORE DELETE ON report_import_receipt
BEGIN
    SELECT RAISE(ABORT, 'Immutable import provenance');
END;

insertImportReceipt:
INSERT INTO report_import_receipt (
    inspection_id, source_sha256, source_byte_size, extractor_version, manifest_sha256,
    source_date, mapping_receipt_json, mapping_sha256, imported_at
) VALUES (
    :inspection_id, :source_sha256, :source_byte_size, :extractor_version, :manifest_sha256,
    :source_date, :mapping_receipt_json, :mapping_sha256, :imported_at
);

selectImportReceiptByInspection:
SELECT * FROM report_import_receipt WHERE inspection_id = :inspection_id;

selectImportReceiptBySource:
SELECT * FROM report_import_receipt WHERE source_sha256 = :source_sha256;

insertFormatExportReceipt:
INSERT INTO report_export_receipt (
    id, inspection_id, audience, quality, rel_path, content_hash, byte_size, exported_at, format
) VALUES (
    :id, :inspection_id, :audience, :quality, :rel_path, :content_hash, :byte_size, :exported_at, :format
);

selectFormatExportReceiptsByInspection:
SELECT * FROM report_export_receipt
WHERE inspection_id = :inspection_id
ORDER BY
    CASE audience WHEN 'LANDLORD' THEN 0 WHEN 'TENANT' THEN 1 END,
    CASE format WHEN 'PDF' THEN 0 WHEN 'HTML' THEN 1 END,
    CASE quality WHEN 'LOW' THEN 0 WHEN 'MEDIUM' THEN 1 WHEN 'HIGH' THEN 2 WHEN 'EXTRA_HIGH' THEN 3 WHEN 'NONE' THEN 4 END;
