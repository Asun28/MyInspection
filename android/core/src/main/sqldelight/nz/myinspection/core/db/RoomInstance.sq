-- 房间是实例不是模板常量（docs/research/opensource-indie.md 要点 6）：多卧室同 stable_id 不得冲突，
-- 靠 instance_no 消歧（如 BEDROOM #1 / BEDROOM #2）。
CREATE TABLE room_instance (
    id TEXT NOT NULL PRIMARY KEY,
    inspection_id TEXT NOT NULL, -- 逻辑外键 -> inspection.id
    room_key TEXT NOT NULL, -- 模板房间键，如 BEDROOM
    instance_no INTEGER NOT NULL,
    display_label TEXT NOT NULL, -- 如 "Bedroom 2 / 次卧"
    created_at INTEGER NOT NULL, -- 行创建时间（见 Property.sq 同名列注释）
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX idx_room_instance_inspection ON room_instance (inspection_id);

-- 同一巡检内 (room_key, instance_no) 不得有两行活跃记录（否则 "BEDROOM #1" 是哪个实例就不确定）。
-- 部分唯一索引，理由同 TemplateVersion.sq / CheckItemDef.sq 的部分索引注释（NULL 在 UNIQUE 里互不相等）。
CREATE UNIQUE INDEX idx_room_instance_active ON room_instance (inspection_id, room_key, instance_no) WHERE deleted_at IS NULL;

-- finalize 只读强制（关键不变量）：巡检 FINALIZED 后不得再挂新房间实例，否则 data_hash 锁定的快照
-- 会被事后追加内容破坏。用 INSERT…SELECT…WHERE 做守卫（INSERT…VALUES 语法无法带 WHERE）；
-- 未命中时 0 行受影响，与 inspection_item.updateStatusIfDraft 的 0 行语义一致。
-- 用 EXISTS 而非「标量子查询 IS NULL」：inspection_id 若指向一个根本不存在的巡检，标量子查询返回
-- NULL，`NULL IS NULL` 为真，guard 反而放行——那是孤儿行的口子。EXISTS 要求父行**真的存在**且是 DRAFT。
insert:
INSERT INTO room_instance (id, inspection_id, room_key, instance_no, display_label, created_at, updated_at)
SELECT :id, :inspection_id, :room_key, :instance_no, :display_label, :created_at, :updated_at
WHERE EXISTS (SELECT 1 FROM inspection WHERE id = :inspection_id AND finalized_at IS NULL);

selectById:
SELECT *
FROM room_instance
WHERE id = :id;

selectByInspection:
SELECT *
FROM room_instance
WHERE inspection_id = :inspection_id AND deleted_at IS NULL;
