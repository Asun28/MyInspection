CREATE TABLE photo (
    id TEXT NOT NULL PRIMARY KEY,
    inspection_item_id TEXT, -- 可空：room 级全景照片只挂 room_instance，不属于具体检查项
    room_instance_id TEXT NOT NULL, -- 逻辑外键 -> room_instance.id
    rel_path TEXT NOT NULL, -- 相对路径；文件系统存储实体文件，DB 禁 BLOB（关键不变量）
    content_hash TEXT NOT NULL, -- 内容哈希，防重复导入
    exif_time_ms INTEGER, -- 拍摄时间（与巡检时间分开记录）
    source TEXT NOT NULL, -- CAMERA / IMPORTED
    privacy_flag INTEGER NOT NULL, -- 0/1；含租客物品标记（NZ OPC 判例风险），报告可据此排除
    created_at INTEGER NOT NULL, -- 行创建时间（见 Property.sq 同名列注释）
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER
);

CREATE INDEX idx_photo_inspection_item ON photo (inspection_item_id);
-- content_hash 打头的索引：orphanedAssets 按 content_hash 做无 room_instance 范围限定的全表自关联
-- 查找，idx_photo_active 以 room_instance_id 打头覆盖不到这个访问模式。
CREATE INDEX idx_photo_content_hash ON photo (content_hash);

-- 去重范围有意收窄到「同一 room_instance 内」而非全库：全库唯一会让同一张照片内容永远不能合法出现
-- 在两次不同巡检里（例如同一处缺陷在 Ingoing 与 Exit 分别拍到时，字节偶然相同；或用户有意把同一张
-- 参考图导入两个不同巡检的同一检查项）。收窄到 room_instance（本就落在单次巡检之内）后，仍能拦住
-- T2-PHOTO-PIPELINE 最常见的误用场景——同一批导入被重复拖入同一房间两次。用部分唯一索引而非表级
-- UNIQUE(...,deleted_at)：SQLite 的 UNIQUE 把 NULL 视为互不相等，表级约束拦不住活跃行重复。
CREATE UNIQUE INDEX idx_photo_active ON photo (room_instance_id, content_hash) WHERE deleted_at IS NULL;

-- finalize 只读强制（关键不变量），EXISTS 理由见 RoomInstance.sq 同名注释。照片没有直接的 inspection_id
-- 列，经 room_instance 两跳查父巡检的 finalized_at；第二个条件校验 inspection_item_id（若提供）真的
-- 属于同一个 room_instance，不能是从别的房间借来的 id。
insert:
INSERT INTO photo (id, inspection_item_id, room_instance_id, rel_path, content_hash, exif_time_ms, source, privacy_flag, created_at, updated_at)
SELECT :id, :inspection_item_id, :room_instance_id, :rel_path, :content_hash, :exif_time_ms, :source, :privacy_flag, :created_at, :updated_at
WHERE EXISTS (
  SELECT 1 FROM room_instance ri
  JOIN inspection i ON i.id = ri.inspection_id
  WHERE ri.id = :room_instance_id AND i.finalized_at IS NULL
) AND (
  :inspection_item_id IS NULL
  OR EXISTS (SELECT 1 FROM inspection_item WHERE id = :inspection_item_id AND room_instance_id = :room_instance_id)
);

selectById:
SELECT *
FROM photo
WHERE id = :id;

selectByRoomInstance:
SELECT *
FROM photo
WHERE room_instance_id = :room_instance_id AND deleted_at IS NULL;

-- 去关联/软删（T2-PHOTO-PIPELINE 孤儿清理链路的前半步：一份物理资产多处关联，去重复用后原关联要能
-- 撤销；其 allow_paths 不含 core/db/）。finalize 只读强制同样适用——FINALIZED 巡检下的照片不得软删，
-- 理由同 insert 侧（否则巡检证据能被事后抽走，破坏 data_hash 锁定的快照）。这条守卫还带来一个免费的
-- 推论，见 orphanedAssets 的注释。
softDelete:
UPDATE photo
SET deleted_at = :deleted_at, updated_at = :deleted_at
WHERE id = :id
  AND deleted_at IS NULL
  AND EXISTS (
    SELECT 1 FROM room_instance ri
    JOIN inspection i ON i.id = ri.inspection_id
    WHERE ri.id = photo.room_instance_id AND i.finalized_at IS NULL
  );

-- 孤儿资产查询（T2-PHOTO-PIPELINE「提供 orphanedAssets() 查询 + 清理用例」，同名以贴合原文）：返回
-- content_hash + rel_path——只回 content_hash 曾经是个坑：调用方拿到孤儿哈希后，selectByRoomInstance
-- 要求已知 room_instance_id 且天生排除软删行（孤儿行恰好就是软删的那些），根本查不回物理文件路径，
-- 清理用例无从下手（R3 评审指出，已改正）。DISTINCT 两列而非只 DISTINCT content_hash：同一哈希若曾
-- 落到过不同 rel_path（多份物理副本），每个路径都要能被清理，不能只删其中一份。"finalize 过的巡检
-- 照片永不清"不需要在这里另写特判：softDelete 已经禁止对 FINALIZED 巡检下的照片软删，所以这类
-- content_hash 永远至少有一行活跃记录，天然不会出现在这份孤儿列表里。
orphanedAssets:
SELECT DISTINCT p1.content_hash, p1.rel_path
FROM photo p1
WHERE p1.deleted_at IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM photo p2 WHERE p2.content_hash = p1.content_hash AND p2.deleted_at IS NULL);
