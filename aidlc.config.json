{
  "schemaVersion": 1,
  "cardsDir": "specs/tasks",
  "archiveDir": "specs/archive/tasks",
  "intentDir": "intent",
  "specsDir": "specs",
  "plansDir": "plans",
  "worktreeRoot": "",
  "base": "master",
  "mode": "remote",
  "shipPath": "scaffold",
  "reviewPool": "default",
  "reviewPolicyVersion": "REVIEW.md@5",
  "reviewer": "reviewer",
  "maxWorkers": 2,
  "family": "claude",
  "provider": "mock",
  "github": {
    "requiredChecks": [],
    "requireVerdict": true
  },
  "ci": {
    "transientSteps": [
      "Set up job",
      "Complete job"
    ]
  },
  "hooks": {
    "frozenPaths": [],
    "testPathPatterns": [
      "(^|/)tests?/",
      "\\.test\\.[cm]?[jt]sx?$",
      "\\.spec\\.[cm]?[jt]sx?$",
      "_test\\.(py|go|kt)$",
      "(^|/)src/test/"
    ],
    "productionPatterns": [
      "\\b(deploy|release|rollout|promote|apply)\\b[^\\n]*\\b(prod|production|live)\\b",
      "\\b(prod|production)\\b[^\\n]*\\b(deploy|release|rollout|promote|apply)\\b"
    ]
  },
  "tierPaths": {
    "tierS": [],
    "tier0": [],
    "frozen": []
  },
  "preReview": {
    "command": [
      "deepseek",
      "--model",
      "deepseek-v4-pro"
    ],
    "reviewer": "deepseek-v4-pro",
    "rounds": 1,
    "timeoutMs": 1200000,
    "onExhausted": "ship",
    "perspectives": [
      "ac-coverage",
      "spec-deviations",
      "edge-cases"
    ],
    "maxDiffBytes": 800000,
    "answerMarker": "=== answer ===",
    "fallback": {
      "command": [
        "claude",
        "-p",
        "--model",
        "claude-sonnet-5-5",
        "--effort",
        "{effort}",
        "--tools",
        "Read,Grep,Glob",
        "--setting-sources=",
        "--strict-mcp-config",
        "--no-session-persistence"
      ],
      "reviewer": "claude-sonnet-5-5",
      "timeoutMs": 1200000,
      "maxDiffBytes": 800000,
      "answerMarker": "",
      "effort": {
        "default": "high",
        "xhigh": {
          "minChangedLines": 500,
          "paths": [
            "src/core/**",
            "src/coordination/**",
            "src/state/**"
          ]
        }
      }
    }
  },
  "formalReview": {
    "command": [
      "codex",
      "exec",
      "-m",
      "gpt-6-astra",
      "-c",
      "model_reasoning_effort={effort}",
      "--sandbox",
      "read-only",
      "--output-schema",
      "{schema}"
    ],
    "reviewer": "codex",
    "timeoutMs": 1200000,
    "maxDiffBytes": 800000,
    "effort": {
      "default": "medium"
    },
    "fallback": {
      "command": [
        "claude",
        "-p",
        "--model",
        "claude-opus-5-5",
        "--effort",
        "{effort}",
        "--tools",
        "Read,Grep,Glob",
        "--setting-sources=",
        "--strict-mcp-config",
        "--no-session-persistence"
      ],
      "reviewer": "claude-opus-5-5",
      "timeoutMs": 1200000,
      "maxDiffBytes": 800000,
      "effort": {
        "default": "medium",
        "high": {
          "minChangedLines": 500,
          "paths": [
            "src/core/**",
            "src/coordination/**",
            "src/state/**"
          ]
        }
      }
    },
    "baseSync": {
      "command": [
        "codex",
        "exec",
        "-m",
        "gpt-6-astra",
        "-c",
        "model_reasoning_effort={effort}",
        "--sandbox",
        "read-only",
        "--output-schema",
        "{schema}"
      ],
      "reviewer": "codex-base-sync",
      "timeoutMs": 1200000,
      "maxDiffBytes": 800000,
      "effort": {
        "default": "medium"
      }
    }
  },
  "repository": "Asun28/MyInspection",
  "gateRequired": true
}
