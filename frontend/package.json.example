{
  "//": "拷掉 .example 后缀即用。脚本即闸:check = 命名(eslint)+ 类型(tsc);test/test:e2e = 确定性测试闸;verify = check+test+test:e2e 一把跑(任务卡 dod_command 用它)。gen:api = 闸2 从后端 OpenAPI 生成前端类型。按实际框架补 dev/build。",
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/types/api.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "openapi-typescript": "^7",
    "vitest": "^4",
    "jsdom": "^25",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@playwright/test": "^1",
    "@axe-core/playwright": "^4"
  }
}
