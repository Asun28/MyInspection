// vitest.setup.ts — 拷掉 .example 后缀即用。
// 全局确定性 + 断言增强,所有 *.test.ts 共享(由 vitest.config 的 setupFiles 引入)。
import '@testing-library/jest-dom/vitest' // toBeInTheDocument / toHaveText 等 DOM 匹配器
import { beforeEach, afterEach, vi } from 'vitest'

// 固定系统时钟:任何 new Date()/Date.now() 在测试里都是这一刻——根除「时间相关」flaky。
// 选一个有意义的固定时刻(UTC),全仓一致。
const FIXED_NOW = new Date('2026-01-01T00:00:00.000Z')

beforeEach(() => {
  vi.useFakeTimers()
  vi.setSystemTime(FIXED_NOW)
})

afterEach(() => {
  vi.useRealTimers()
})
