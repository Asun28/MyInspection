// playwright.config.ts — 拷掉 .example 后缀即用。
// E2E 的最小确定性配置:单 chromium、retries:0(retry 会掩盖 flaky=非确定)、动画关闭。
// 任务卡 dod_command 跑:  npm run test:e2e   (=> playwright test,退出码即闸 0/1)
import { defineConfig, devices } from '@playwright/test'

export default defineConfig({
  testDir: './e2e',
  // 确定性铁律:retries 必须为 0。允许重试 = 容忍不确定 = 闸失效。
  retries: 0,
  // 串行更可复现(无并发竞态);量大再开 workers。
  fullyParallel: false,
  forbidOnly: !!process.env.CI, // CI 里残留的 test.only 直接判失败
  reporter: 'list',
  use: {
    // 下游改成本地 dev server 地址(或在 webServer 段启动)。
    baseURL: 'http://localhost:5173',
    trace: 'on-first-retry', // retries:0 时实际只在手动调试留痕
    reducedMotion: 'reduce', // 关动画/过渡:消除「等动画结束」类 flaky
  },
  projects: [
    { name: 'chromium', use: { ...devices['Desktop Chrome'] } },
  ],

  // ── 可视回归(toHaveScreenshot)默认关闭 · 仅当「布局本身」是被测对象时才开 ─────────────
  // 优先用 DOM/文本断言(getByRole/getByTestId/toHaveText),跨平台稳、无需 Docker。
  // 若确需像素基线:基线只能在固定 tag 的 Linux 容器里生成,Windows 本机基线会因 OS 字体渲染差异
  // 在 Linux CI 上炸。生成基线(人工闸,agent 绝不自动 --update-snapshots):
  //   docker run --rm -v ${PWD}:/work -w /work mcr.microsoft.com/playwright:v1.50.0-jammy \
  //     npx playwright test --update-snapshots
  // 开启时再取消下面注释并指定 snapshotPathTemplate:
  // snapshotPathTemplate: '{testDir}/__screenshots__/{testFilePath}/{arg}{ext}',
})
