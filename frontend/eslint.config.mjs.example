// eslint.config.mjs — 拷掉 .example 后缀即用。
// 机检前端命名规范（与 CLAUDE.md「代码与接口命名」同源）+ 类型一致性的第一道闸。
// 装依赖：npm i -D eslint typescript typescript-eslint @typescript-eslint/parser
// 任务卡 dod_command 跑：  npx eslint . --max-warnings=0 && npx tsc --noEmit
import tseslint from 'typescript-eslint'

export default tseslint.config(
  ...tseslint.configs.recommended,
  {
    files: ['**/*.{ts,tsx}'],
    rules: {
      // 命名规范机检：组件/类型 PascalCase，变量/函数 camelCase，常量 UPPER_CASE，
      // 布尔以 is/has/should 起头；类型成员/属性放宽到 camelCase（API 字段对齐见下注）。
      '@typescript-eslint/naming-convention': [
        'error',
        { selector: 'default', format: ['camelCase'] },
        { selector: 'variable', format: ['camelCase', 'UPPER_CASE', 'PascalCase'] },
        { selector: 'function', format: ['camelCase', 'PascalCase'] }, // PascalCase 容许 React 组件函数
        { selector: 'typeLike', format: ['PascalCase'] },              // type / interface / class / enum
        { selector: 'variable', types: ['boolean'], format: ['camelCase'], prefix: ['is', 'has', 'should', 'can'] },
        // API 边界字段名由后端 schema 决定（见闸 2：openapi-typescript 生成的类型），
        // 故对 import 自 ./types/api 的成员豁免命名规则——不要在前端重命名后端字段。
        { selector: 'property', format: null, filter: { regex: '^(.*_.*)$', match: true } },
      ],
      // hook 命名 useXxx 由 eslint-plugin-react-hooks 配合（按框架增配）。
    },
  },
  { ignores: ['dist/**', 'node_modules/**', 'src/types/api.ts'] }, // 生成的 API 类型不参与命名 lint
)
