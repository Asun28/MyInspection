// e2e/example.spec.ts — 拷掉 .example 后缀即用。
// 【AI agent 应复制的规范 E2E 模式】最小但齐全:
//   ① 失败闭合(fail-closed)离线 mock:拦截所有请求,放行预期、abort 意外 => 测试里零真实网络
//   ② DOM/文本断言(getByRole/getByTestId/toHaveText),不用像素截图 => 跨平台稳
//   ③ 零 console 错误检查 => 抓「看着对、其实坏」
//   ④ 一条 @axe-core/playwright 可达性断言 => a11y 底线进闸
// 确定性铁律:固定时钟、关动画(config 里 reducedMotion)、靠 auto-wait/waitForLoadState 不手写 sleep。
import { test, expect } from '@playwright/test'
import AxeBuilder from '@axe-core/playwright'

test('首页:离线确定性、关键 DOM、零报错、a11y', async ({ page }) => {
  // ── 固定时钟:页面内 Date.now()/new Date() 全部锁定,根除时间相关 flaky ──────────────
  await page.clock.setFixedTime(new Date('2026-01-01T00:00:00.000Z'))

  // ── ① fail-closed 离线 mock ───────────────────────────────────────────────────────
  // 先拦截全部网络:预期的 API 用 fulfill 喂固定夹具,任何未预期请求一律 abort => 测试不碰真网。
  await page.route('**/*', async (route) => {
    const url = route.request().url()
    if (url.startsWith('http://localhost')) {
      return route.continue() // 放行本地 app 自身的页面/静态资源
    }
    if (url.includes('/api/health')) {
      // 预期的后端调用:回放确定性夹具(键名须与后端契约 schema 同名,见 README 闸 2/闸 4)。
      return route.fulfill({
        status: 200,
        contentType: 'application/json',
        body: JSON.stringify({ status: 'ok' }),
      })
    }
    // 未预期的外发请求 = 失败信号(可能是漏 mock 的真实网络),直接 abort 让测试可感知。
    return route.abort()
  })

  // ── 零 console 错误检查:边导航边收集,最后断言为空 ─────────────────────────────────
  const consoleErrors: string[] = []
  page.on('console', (msg) => {
    if (msg.type() === 'error') consoleErrors.push(msg.text())
  })

  await page.goto('/')
  await page.waitForLoadState('networkidle') // auto-wait 替代手写 sleep

  // ── ② DOM/文本断言(公共测试 API = data-testid,kebab-case、行为导向) ─────────────
  await expect(page.getByRole('heading', { level: 1 })).toBeVisible()
  await expect(page.getByTestId('health-status')).toHaveText('ok')

  // ── ③ 零 console 错误 ─────────────────────────────────────────────────────────────
  expect(consoleErrors).toEqual([])

  // ── ④ 一条 a11y 断言:无可访问性违规 ───────────────────────────────────────────────
  const a11y = await new AxeBuilder({ page }).analyze()
  expect(a11y.violations).toEqual([])
})
